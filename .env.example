# Environment Variables voor Platform Analytics
# 
# Dit is een TEMPLATE bestand (.env.example)
# Kopieer dit naar .env en pas de waarden aan:
#   Copy-Item .env.example .env
#   
# BELANGRIJK: Verander alle default wachtwoorden naar veilige waarden!
# Het .env bestand wordt NIET gecommit naar Git (staat in .gitignore)

# Elastic Stack versie
ELASTIC_VERSION=8.15.3

# Elasticsearch
ELASTIC_PASSWORD=changeme

# Logstash
LOGSTASH_INTERNAL_PASSWORD=changeme

# Kibana
KIBANA_SYSTEM_PASSWORD=changeme

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# GitLab CI/CD (automatisch ingevuld door GitLab)
CI_REGISTRY_IMAGE=registry.gitlab.com/kdg-ti/integratieproject-j3/teams-25-26/team14/platform-analytics
IMAGE_TAG=latest
